with "vss_text";
with "xmlada_sax";
with "gnatcoll_sqlite";
with "gnatcoll_xref";
with "../shared/gnatstudio_shared";

project common is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Object_Dir use Gnatstudio_Shared'Object_Dir;

   --  Trim GNAT Studio-only subsystems that the TUI stack does not use
   --  (build configurations, command framework, remote/toolchains UI, etc.).
   --  This keeps the common crate focused on the minimal utilities needed by
   --  the Ada/SPARK TUI, lsp_client, and language(Ada) crates.
   --  The corresponding source files have been removed from src/ because the
   --  TUI stack does not depend on them anymore, so no explicit
   --  Excluded_Source_Files list is required here.

   package Compiler is
      for Switches ("Ada") use Gnatstudio_Shared.Compiler'Switches ("Ada");
      for Switches ("C") use Gnatstudio_Shared.Compiler'Switches ("C");
      for Switches ("test_htables.adb") use ("-g", "-O2", "-gnatwue");
      for Switches ("s-memory.adb") use ("-g", "-O2", "-gnatpg");

      No_Checks := ("-g", "-O2", "-gnat2012", "-gnatpn");

      --  Simplify build policy; no per-profile overrides
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-E");
   end Binder;

   package Linker extends Gnatstudio_Shared.Linker is
      for Linker_Options use Gnatstudio_Shared.Linker'Linker_Options & () & ("-lutil");
   end Linker;

   package Coverage is
      for Excluded_Units use ("System.Memory");
   end Coverage;

end common;
