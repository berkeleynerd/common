V "GNAT Lib v15"
A -O0
A -Wtrampolines
A -gnatA
A -g
A -gnatX
A -gnata
A -gnatVa
A -gnatQ
A -gnatyg
A -gnatyO
A -gnatwa
A -gnatwC
A -gnatwJ
A -gnatwe
A -gnateE
A -mmacosx-version-min=26.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P ZX

RN
RV NO_ACCESS_SUBPROGRAMS
RV NO_ALLOCATORS
RV NO_EXCEPTIONS
RV NO_IMPLICIT_CONDITIONALS
RV NO_LOCAL_ALLOCATORS
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_ELABORATION_CODE

U indent_stack%s	indent_stack.ads	f5538f91 EE OO PK
W ada%s			ada.ads			ada.ali
Z ada.exceptions%s	a-except.adb		a-except.ali
Z ada.unchecked_deallocation%s
W generic_stack%s	generic_stack.adb	generic_stack.ali  ED
Z system%s		system.ads		system.ali
Z system.exception_table%s  s-exctab.adb	s-exctab.ali
Z system.standard_library%s  s-stalib.adb	s-stalib.ali

D ada.ads		20250419085653 76789da1 ada%s
D a-except.ads		20250419085653 e7970cd9 ada.exceptions%s
D a-unccon.ads		20250419085653 0e9b276f ada.unchecked_conversion%s
D a-uncdea.ads		20250419085653 c3a8ac65 ada.unchecked_deallocation%s
D generic_stack.ads	20251111131459 a5b372bd generic_stack%s
D generic_stack.adb	20251111131459 7b29383b generic_stack%b
D indent_stack.ads	20251111131459 50e0fd2c indent_stack%s
D system.ads		20250419085653 70765b54 system%s
D s-exctab.ads		20250419085653 91bef6ef system.exception_table%s
D s-parame.ads		20250419085653 3597fc11 system.parameters%s
D s-stalib.ads		20250419085653 1c9580f6 system.standard_library%s
D s-traent.ads		20250419085653 c81cbf8c system.traceback_entries%s
G a e
G c s s s [s indent_stack 20 1 none]
G c Z s s [indent_typeIP indent_stack 22 9 none]
G c Z s s [push indent_stack__stack 28 14 30_4]
G c Z s s [pop indent_stack__stack 31 14 30_4]
G c Z s s [pop indent_stack__stack 35 14 30_4]
G c Z s s [top indent_stack__stack 39 13 30_4]
G c Z s s [next indent_stack__stack 45 13 30_4]
G c Z s s [traverse_stack indent_stack__stack 48 14 30_4]
G c Z s s [clear indent_stack__stack 54 14 30_4]
G c Z s s [is_empty indent_stack__stack 58 13 30_4]
G c Z s s [simple_stackIP indent_stack__stack 65 9 30_4]
G c Z s s [type_arrayIP indent_stack__stack 62 9 30_4]
G c Z s s [unchecked_free indent_stack__stack 22 14 30_4]
G r i none [s indent_stack 20 1 none] [generic_stack standard 20 9 none]
X 5 generic_stack.ads
20k9*Generic_Stack 74e18 7|18w6 30r25
X 7 indent_stack.ads
20K9*Indent_Stack 32l5 32e17
22R9*Indent_Type 28e14 30r40
23i7*Level{integer}
24i7*Align_Arrow{natural}
26i7*Line{natural}
27i7*Continuation_Val{natural}
30K12*Stack[5|20]

